# Copy to .env (git-ignored). All values shown are the defaults.
INGLE_ADDR=:8080
INGLE_DB_PATH=./data/ingle.db
# Postgres instead of SQLite (Hosted only; see `task pg:up`):
# INGLE_DATABASE_URL=postgres://ingle:ingle@127.0.0.1:55432/ingle?sslmode=disable
INGLE_TZ=Europe/London
INGLE_DATE_FORMAT=02/01/2006
INGLE_WEEK_START=monday
INGLE_CURRENCY=GBP
# Optional read-only photos folder for the screensaver (unset = none).
# INGLE_PHOTOS_DIR=/path/to/photos
