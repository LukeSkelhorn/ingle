# Copy to .env (git-ignored). All values shown are the defaults.
DOMUS_ADDR=:8080
DOMUS_DB_PATH=./data/domus.db
DOMUS_TZ=Europe/London
DOMUS_DATE_FORMAT=02/01/2006
DOMUS_WEEK_START=monday
DOMUS_CURRENCY=GBP
# Optional read-only photos folder for the screensaver (unset = none).
# DOMUS_PHOTOS_DIR=/path/to/photos
