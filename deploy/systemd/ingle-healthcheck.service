# Ask the running Ingle whether it's healthy (its database answers).
# Started every few minutes by ingle-healthcheck.timer. A failure shows
# in `systemctl --failed` and the journal; add OnFailure= with
# `sudo systemctl edit ingle-healthcheck` to be told about it.

[Unit]
Description=Ingle health check
After=ingle.service

[Service]
Type=oneshot
User=ingle
Group=ingle
ExecStart=/usr/local/bin/ingle healthcheck

Environment=INGLE_ADDR=127.0.0.1:8080
EnvironmentFile=-/etc/ingle/ingle.env

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
