# Ingle settings for the systemd service. Copy to /etc/ingle/ingle.env.
# Every setting: https://ingleboard.app/docs/self-hosting/configuration/
# These override the defaults in ingle.service. Restart after a change:
#   sudo systemctl restart ingle

# Where Ingle listens. Keep it on 127.0.0.1 with Caddy on the same box;
# use 0.0.0.0:8080 to reach it directly on the LAN, without HTTPS.
INGLE_ADDR=127.0.0.1:8080

# Caddy (or another proxy) on this box: believe its X-Forwarded-For, so
# sign-in and unlock attempts are rate-limited per device.
INGLE_TRUSTED_PROXIES=127.0.0.1

# The timezone for a new household. Change it later in Admin › Settings.
INGLE_TZ=Europe/London
TZ=Europe/London

# Nightly backups: how many to keep (0 turns them off) and when.
# INGLE_BACKUP_KEEP=14
# INGLE_BACKUP_AT=03:00
# Somewhere other than /var/lib/ingle/backups? Also give the service
# access: sudo systemctl edit ingle, then ReadWritePaths=/mnt/backup/ingle
# INGLE_BACKUP_DIR=/mnt/backup/ingle

# A read-only folder of photos for the screensaver (a NAS share, say).
# INGLE_PHOTOS_DIR=/mnt/nas/photos
