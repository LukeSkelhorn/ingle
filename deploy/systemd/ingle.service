# Ingle as a systemd service, without Docker.
# Guide: https://ingleboard.app/docs/self-hosting/without-docker/
#
# Install: copy to /etc/systemd/system/, create the ingle user and
# /etc/ingle/ingle.env (see ingle.env.example), then
#   sudo systemctl enable --now ingle
# Change anything here with `sudo systemctl edit ingle` rather than editing
# this file, so an update doesn't overwrite your changes.

[Unit]
Description=Ingle family chores board
Documentation=https://ingleboard.app/docs/self-hosting/without-docker/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ingle
Group=ingle
ExecStart=/usr/local/bin/ingle
Restart=on-failure
RestartSec=5s

# Defaults; anything in /etc/ingle/ingle.env overrides them.
Environment=INGLE_ADDR=127.0.0.1:8080
Environment=INGLE_DB_PATH=/var/lib/ingle/ingle.db
Environment=INGLE_BACKUP_DIR=/var/lib/ingle/backups
EnvironmentFile=-/etc/ingle/ingle.env

# /var/lib/ingle, owned by the ingle user. It's the only place Ingle can
# write. For backups somewhere else, add ReadWritePaths= for that folder.
StateDirectory=ingle
StateDirectoryMode=0750
UMask=0027

# Hardening. Ingle needs no privileges: it listens on a high port, talks
# to the network for calendar feeds, and writes only its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
