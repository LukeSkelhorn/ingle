# Copy to .env next to compose.yaml (it's git-ignored) and fill in.

# The address the family will type, e.g. ingle.home.example.com. Add a DNS
# A record for it pointing at this server's LAN IP (DNS only, not proxied).
INGLE_HOSTNAME=ingle.home.example.com

# A Cloudflare API token with Zone › DNS › Edit on that domain only. Caddy
# uses it to prove you own the domain and get a Let's Encrypt certificate.
CLOUDFLARE_API_TOKEN=

# Image tag to run, e.g. v0.1.0. "latest" follows every release.
INGLE_TAG=latest

# Household defaults (the timezone can be changed later in Admin › Settings).
INGLE_TZ=Europe/London
INGLE_DATE_FORMAT=02/01/2006
INGLE_WEEK_START=monday
INGLE_CURRENCY=GBP

# Nightly backups: where they go on this machine (point it at a NAS mount if
# you can), how many to keep (0 turns them off) and when they run.
BACKUP_PATH=./backups
INGLE_BACKUP_KEEP=14
INGLE_BACKUP_AT=03:00

# Optional read-only photos folder: also uncomment the volume in compose.yaml.
# PHOTOS_PATH=/mnt/nas/photos
# INGLE_PHOTOS_DIR=/photos

# Change only if 172.30.40.0/24 clashes with another network you use. The
# proxy IP must be inside the subnet.
# INGLE_SUBNET=172.30.40.0/24
# INGLE_PROXY_IP=172.30.40.2
